export default async function AboutPage() {
  return (
    <section style={{ maxWidth: "720px", display: "grid", gap: "20px" }}>
      <h1 style={{ margin: "0", fontSize: "clamp(2.5rem, 6vw, 4rem)" }}>About nextsx</h1>
      <p style={{ margin: "0", lineHeight: "1.8", color: "rgba(248, 247, 241, 0.78)" }}>
