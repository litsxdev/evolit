// @ts-nocheck
import "./showcase-badge.css";
import pulseDot from "./pulse-dot.svg";

/**
 * @param {{ label: string }} props
 */
export default function ShowcaseBadge(props) {
  const { label } = props;

  return (
    <span class="showcase-badge">
      <img src={pulseDot} alt="" />
      <span>{label}</span>
    </span>
  );
}
