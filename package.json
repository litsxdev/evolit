{
  "name": "evolit",
  "version": "0.1.0-alpha.5",
  "description": "A convention-driven application framework for LitSX and web components.",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litsxdev/nextsx.git"
  },
  "bugs": {
    "url": "https://github.com/litsxdev/nextsx/issues"
  },
  "homepage": "https://github.com/litsxdev/nextsx#readme",
  "files": [
    "src",
    "templates"
  ],
  "bin": "./src/cli.js",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": {
      "browser": "./src/request-context-browser.js",
      "default": "./src/server-api.js"
    }
  },
  "scripts": {
    "dev": "node ./src/cli.js dev",
    "build": "node ./src/cli.js build",
    "start": "node ./src/cli.js start",
    "test": "node --test",
    "typecheck": "litsx-tsc -p jsconfig.json --noEmit",
    "release:check": "yarn test && yarn typecheck && yarn pack --dry-run"
  },
  "keywords": [
    "evolit",
    "litsx",
    "lit",
    "ssr",
    "routing"
  ],
  "author": "LitSX Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.5"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@litsx/compiler": "0.9.5-canary-feat-ssr-20260726130435",
    "@litsx/core": "0.17.0-canary-feat-ssr-20260726130435",
    "@litsx/ssr": "0.2.0-canary-feat-ssr-20260726130435",
    "@litsx/typescript": "^0.9.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "lit": "^3.3.3",
    "magic-string": "^1.1.0",
    "rollup": "^4.46.1",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  }
}
