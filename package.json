{
  "name": "evolit-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "test": "yarn workspace evolit test",
    "test:browser": "yarn workspace evolit test:browser",
    "typecheck": "yarn workspace evolit typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:version:snapshot": "changeset version --snapshot ${EVOLIT_SNAPSHOT_TAG:-canary}",
    "release:check": "yarn test && yarn typecheck && yarn workspace evolit release:check",
    "release:preflight": "yarn install --immutable && yarn changeset:status && yarn release:check",
    "release:publish": "yarn release:check && changeset publish"
  }
}
